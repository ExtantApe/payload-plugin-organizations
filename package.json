{
  "name": "@extantape/payload-plugin-organizations",
  "version": "0.4.0",
  "description": "Organizations for Payload: places people work or belong, with Coordinator, Member and Viewer levels, pending organizations a host approves, a shipped list of public mail domains, and a picker field. Access rules are the host's.",
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "organizations",
    "memberships",
    "access-control",
    "ror",
    "email-domains",
    "teams"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ExtantApe/payload-plugin-organizations#readme",
  "bugs": {
    "url": "https://github.com/ExtantApe/payload-plugin-organizations/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExtantApe/payload-plugin-organizations.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "payload": "^3.92.1"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/graphql": "3.92.1",
    "@types/node": "^24.0.0",
    "graphql": "^16.14.2",
    "mongodb-memory-server": "^11.3.0",
    "payload": "3.92.1",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "tldts": "7.5.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
