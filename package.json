{
  "name": "@extantape/payload-plugin-organizations",
  "version": "0.0.0",
  "private": true,
  "description": "Organizations for Payload: a curated list of zoos, labs, museums and other institutions, with ROR and Wikidata importers, a picker field, user suggestions a curator merges, and an email-domain hint that never grants access.",
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "organizations",
    "institutions",
    "ror",
    "wikidata",
    "zoos",
    "curation"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ExtantApe/payload-plugin-organizations#readme",
  "bugs": {
    "url": "https://github.com/ExtantApe/payload-plugin-organizations/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExtantApe/payload-plugin-organizations.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "payload": "^3.80.0"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@types/node": "^24.0.0",
    "graphql": "^16.14.2",
    "mongodb-memory-server": "^11.3.0",
    "payload": "3.92.1",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
